# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Local: `pnpm db:up` starts Postgres in Docker. Hosted: Neon's pooled connection string.
DATABASE_URL=postgres://ferry:ferry@localhost:5432/ferry
# Optional direct (unpooled) connection, used only by migrations.
DATABASE_URL_UNPOOLED=

# Comma-separated web origins allowed to call the API. In development, LAN origins
# (http://192.168.x.x:5173 etc.) are also allowed automatically.
CORS_ORIGINS=http://localhost:5173
PUBLIC_WEB_ORIGIN=http://localhost:5173

# Polygon: comma-separated RPC URLs, tried in order.
POLYGON_RPC_URLS=https://polygon-bor-rpc.publicnode.com,https://polygon.drpc.org
USDT0_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F

# Relayer hot wallet: pays POL gas for gasless transfers. Keep its balance small.
RELAYER_PRIVATE_KEY=

# Paycrest (payout partner). `mock` fakes account checks and orders, with live rates and banks.
# `live` needs a KYB-verified sender key.
PAYCREST_MODE=mock
PAYCREST_BASE_URL=https://api.paycrest.io
PAYCREST_API_KEY=
PAYCREST_API_SECRET=

# Fees and limits (USD, USDT treated 1:1).
FERRY_FEE_PERCENT=0.5
LIMIT_MIN_USD=1
LIMIT_MAX_USD=200
LIMIT_DAILY_USD=500
CORRIDORS_ENABLED=NGN,KES,UGX,TZS

# Payouts. fonbnk = Fonbnk's hosted flow (no key); paycrest = needs a KYB'd Paycrest key.
PAYOUT_ROUTE=fonbnk
# Relayer POL sent so a wallet with USDT but no POL can pay the fee for its cash-out transfer.
GAS_TOPUP_ENABLED=false
GAS_TOPUP_CAP_POL=0.3
# Least a top-up fills a wallet to, so a fee spike before the send doesn't leave it short.
GAS_TOPUP_FLOOR_POL=0.12
GAS_TOPUP_PER_ADDRESS_DAY=3
GAS_TOPUP_DAILY_MAX=100

# Proof of Ferry leaves these wallets out (comma-separated): the builder's own and test wallets.
PROOF_EXCLUDE_ADDRESSES=
