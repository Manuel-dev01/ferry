# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Local: `pnpm db:up` starts Postgres in Docker. Production: a Neon connection string.
DATABASE_URL=postgres://ferry:ferry@localhost:5432/ferry

# Comma-separated web origins allowed to call the API. In development, LAN origins
# (http://192.168.x.x:5173 etc.) are also allowed automatically.
CORS_ORIGINS=http://localhost:5173
PUBLIC_WEB_ORIGIN=http://localhost:5173

# Polygon: comma-separated RPC URLs, tried in order.
POLYGON_RPC_URLS=https://polygon-bor-rpc.publicnode.com,https://polygon.drpc.org
USDT0_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F

# Relayer hot wallet: pays POL gas for gasless transfers. Keep its balance small.
RELAYER_PRIVATE_KEY=

# Phase 0 spikes. Keep these off outside development.
SPIKES_ENABLED=false
# The only address spike transfers may pay (use a wallet you control).
SPIKE_ALLOWED_RECIPIENT=
SPIKE_MAX_USDT=1
SPIKE_MAX_RELAYS=10
SPIKE_LN_MAX_SATS=2000
GAS_DRIP_ENABLED=false
GAS_DRIP_AMOUNT_POL=0.02
GAS_DRIP_MAX_TOTAL=5
