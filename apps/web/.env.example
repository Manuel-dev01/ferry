# Copy to .env.local for development. Everything here ends up in the public web bundle:
# never put secrets in VITE_* variables.

# API base URL. Leave empty in development to use http://<this page's host>:3000.
VITE_API_URL=
# Public origin, used for "Open in Nimiq Pay" deep links.
VITE_PUBLIC_ORIGIN=
# Development only: fake Nimiq Pay wallets so the full flow runs in a desktop browser.
# Ignored by production builds.
VITE_MOCK_WALLET=false
# Show the Phase 0 spike screens.
VITE_SPIKES=false
# Optional error reporting.
VITE_SENTRY_DSN=
